# ============================================================
#  Tech Daily Digest – Template biến môi trường
#  Copy file này thành .env và điền thông tin thật vào
# ============================================================

# Gemini API Key (aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP – App Password (KHÔNG phải mật khẩu Gmail thường)
# Tạo tại: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email nhận tin tức
RECIPIENT_EMAIL=your_email@gmail.com

# Thời gian gửi (24h format, GMT+7)
SEND_HOUR=7
SEND_MINUTE=0
